# Copy to .env for local real-mode runs. NEVER commit .env (it is git-ignored).
# --- mode: "mock" runs everything locally with fake data, no cloud accounts needed
BACKEND_MODE=mock

# --- Earth Engine + Google Cloud (real mode)
EE_PROJECT=
EE_SERVICE_ACCOUNT_JSON=        # full JSON key, or base64 of it. Set in Vercel / Cloud Run secrets, not in files.
GCS_BUCKET=

# --- Upstash Redis (job state, cache, rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloud Tasks -> Cloud Run worker
TASKS_PROJECT=
TASKS_LOCATION=us-central1
TASKS_QUEUE=flood-jobs
WORKER_URL=                      # https://<service>-<hash>-uc.a.run.app
TASKS_INVOKER_SA=                # service account allowed to invoke the worker

# --- misc
IP_SALT=                         # random string; makes stored client ids unreadable
SIGNED_URLS=0                    # 1 = time-limited signed download links instead of public-read
# Optional limits (defaults shown)
# MAX_AREA_KM2=5000  PRE_MIN_DAYS=7  PRE_MAX_DAYS=30  POST_MIN_DAYS=7  POST_MAX_DAYS=14
# RATE_PREFLIGHT_PER_HOUR=20  RATE_JOBS_PER_HOUR=3  GLOBAL_JOBS_PER_DAY=30  JOB_TIMEOUT_MIN=90
# ROADS_MOTORABLE_ONLY=1  SETTLEMENT_BUFFER_M=250
